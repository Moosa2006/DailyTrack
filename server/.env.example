# =============================================================================
# DailyTrack Backend Environment Variables (.env.example)
# =============================================================================
# Platform: Render Web Service (Settings -> Environment)
# Visibility: Server-only (DO NOT expose in client code or commit actual values to Git)
# =============================================================================

# Port on which the Express HTTP server listens.
# Defaults to 10000 on Render; defaults to 5000 in local development.
PORT=10000

# MongoDB Atlas connection URI. Replace <db_user> and <db_password> with your database user credentials.
# Ensure Network Access in MongoDB Atlas allows 0.0.0.0/0 (required for Render dynamic IPs).
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/dailytrack?retryWrites=true&w=majority

# Secret key used for signing and verifying JWT tokens.
# Must be at least 32 characters long. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate_a_secure_random_32_character_hex_secret

# Allowed frontend origin(s) for CORS. Set to your Vercel URL.
# Can be comma-separated if you have multiple domains (e.g. custom domain + vercel.app domain).
CLIENT_ORIGIN=https://dailytrack.vercel.app

# Node execution environment. Set to 'production'.
NODE_ENV=production
