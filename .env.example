# =============================================================================
# DailyTrack — Master Environment Variables Specification (.env.example)
# =============================================================================
#
# ARCHITECTURE OVERVIEW:
# - Frontend: Single-Page Application (SPA) deployed to VERCEL
# - Backend:  Express REST API deployed as a Web Service to RENDER
# - Database: MongoDB Atlas (M0 Free or Dedicated Cluster)
#
# =============================================================================
# 1. FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Project Settings)
# =============================================================================
# Variable:    VITE_API_URL
# Platform:    Vercel (Frontend)
# Scope:       Public (bundled into client JavaScript at build time by Vite)
# Purpose:     The public HTTPS base URL of the backend API hosted on Render.
# Source:      Obtained from Render dashboard after deploying the Web Service.
# Example:     https://dailytrack-api.onrender.com
# Notes:       DailyTrack automatically normalizes this value whether you provide
#              the root domain or append /api. In local dev, defaults to /api (proxied).
VITE_API_URL=https://dailytrack-api.onrender.com/api

# =============================================================================
# 2. BACKEND ENVIRONMENT VARIABLES (Configure in Render Web Service Settings)
# =============================================================================
#
# Variable:    PORT
# Platform:    Render (Backend)
# Scope:       Server-only / Private
# Purpose:     Port on which the Express HTTP server listens.
# Source:      Render sets this automatically (usually 10000). In local dev, defaults to 5000.
PORT=10000

# Variable:    MONGO_URI
# Platform:    Render (Backend)
# Scope:       Server-only / Secret (NEVER expose to client or commit to Git)
# Purpose:     Connection URI for the MongoDB database (Mongoose ODM).
# Source:      MongoDB Atlas dashboard: "Connect" -> "Drivers" -> connection string.
# Format:      mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/dailytrack?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/dailytrack?retryWrites=true&w=majority

# Variable:    JWT_SECRET
# Platform:    Render (Backend)
# Scope:       Server-only / Secret (NEVER expose to client or commit to Git)
# Purpose:     Cryptographic secret key used to sign and verify JSON Web Tokens (auth).
# Source:      Generate a secure random string (e.g. `openssl rand -hex 32` or via Render Blueprint).
JWT_SECRET=generate_a_secure_random_32_character_hex_secret

# Variable:    CLIENT_ORIGIN
# Platform:    Render (Backend)
# Scope:       Server-only / Configuration
# Purpose:     Allowed frontend origin(s) for Cross-Origin Resource Sharing (CORS).
# Source:      Your Vercel deployment URL (e.g. https://your-project.vercel.app).
# Notes:       Supports multiple comma-separated URLs (e.g. https://app.com,https://dailytrack.vercel.app).
#              Vercel preview branches (*.vercel.app) and local development origins are permitted automatically.
CLIENT_ORIGIN=https://dailytrack.vercel.app

# Variable:    NODE_ENV
# Platform:    Render (Backend)
# Scope:       Server-only / Runtime
# Purpose:     Tells Node.js and Express to run in production mode (disables dev error stacks, optimizes caching).
# Source:      Set statically to `production`.
NODE_ENV=production
